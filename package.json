{
  "name": "easy-codex",
  "version": "1.0.0",
  "private": true,
  "description": "从一句需求，到经过审查和验收的功能。基于 Pi Durable 构建的开发 Agent。",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "web": "pnpm --filter @easy-codex/web dev"
  },
  "keywords": [
    "agent",
    "pi-durable",
    "workflow"
  ],
  "license": "ISC",
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
